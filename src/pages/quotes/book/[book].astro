---
import Layout from "../../../layouts/Layout.astro";
import QuoteCard from "../../../components/QuoteCard";
import AdUnit from "../../../components/AdUnit.astro";
import BreadcrumbSchema from "../../../components/schema/BreadcrumbSchema.astro";
import QuoteSchema from "../../../components/schema/QuoteSchema.astro";
import BookSchema from "../../../components/schema/BookSchema.astro";
import { getQuoteBooks } from "../../../utils/quotes";
import "../../../components/CardsContainer.css";

export async function getStaticPaths() {
  return getQuoteBooks().map((entry) => ({
    params: { book: entry.slug },
    props: { book: entry.book, author: entry.author, authorSlug: entry.authorSlug, cover: entry.cover, quotes: entry.quotes },
  }));
}

const { book, author, authorSlug, cover, quotes } = Astro.props;
const bookSlug = Astro.params.book as string;

const authorUrl = `https://elhellal.com/quotes/${encodeURIComponent(authorSlug)}/`;
const canonicalUrl = `https://elhellal.com/quotes/book/${encodeURIComponent(bookSlug)}/`;

const otherBooksByAuthor = getQuoteBooks()
  .filter((b) => b.authorSlug === authorSlug && b.slug !== bookSlug)
  .slice(0, 8);

const pageDescription = `${quotes.length} اقتباساً من كتاب "${book}" لـ${author}، مترجماً إلى العربية.`;

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://elhellal.com/quotes" },
  { name: book },
];
---

<Layout
  site={`الهلال - اقتباسات من ${book}`}
  title="الهلال"
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle={`اقتباسات من كتاب ${book} | الهلال`}
  pageDescription={pageDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={`اقتباسات من ${book} | الهلال`}
  ogDescription={`${quotes.length} اقتباساً من ${book}`}
  ogUrl={canonicalUrl}
  ogImage={cover}
  ogType="book"
>
  <BookSchema name={book} url={canonicalUrl} authorName={author} authorUrl={authorUrl} image={cover} description={pageDescription} />
  <QuoteSchema quotes={quotes} url={canonicalUrl} />
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="quote-book-page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/quotes">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <span>{book}</span>
    </nav>

    <header class="book-header">
      {cover ? (
        <img src={cover} alt={book} class="book-cover-lg" loading="eager" />
      ) : (
        <span class="book-cover-lg book-cover-lg-fallback" aria-hidden="true">{book.trim().charAt(0)}</span>
      )}
      <div class="book-identity">
        <span class="book-badge">كتاب</span>
        <h1>{book}</h1>
        <p class="book-author-line">
          بقلم <a href={`/quotes/${encodeURIComponent(authorSlug)}/`} class="book-author-link">{author}</a>
        </p>
        <div class="book-stats">
          <span class="book-stat">{quotes.length} اقتباساً</span>
        </div>
      </div>
    </header>

    <AdUnit slot="8525183818" format="fluid" layout="in-article" className="quote-page-ad" />

    <section aria-label={`اقتباسات من كتاب ${book}`}>
      <ul role="list" class="link-card-grid">
        {quotes.map((quote) => (
          <QuoteCard client:visible quote={quote} />
        ))}
      </ul>
    </section>

    {otherBooksByAuthor.length > 0 && (
      <section class="other-books" aria-label={`كتب أخرى لـ ${author}`}>
        <h2>كتب أخرى لـ{author}</h2>
        <ul role="list" class="other-books-grid">
          {otherBooksByAuthor.map((b) => (
            <li>
              <a href={`/quotes/book/${encodeURIComponent(b.slug)}/`} class="other-book-card">
                {b.cover ? (
                  <img src={b.cover} alt={b.book} class="other-book-cover" loading="lazy" />
                ) : (
                  <span class="other-book-cover other-book-cover-fallback" aria-hidden="true">{b.book.trim().charAt(0)}</span>
                )}
                <span class="other-book-title">{b.book}</span>
                <span class="other-book-count">{b.quotes.length} اقتباساً</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="page-nav">
      <a href="/quotes" class="back-link">كل الاقتباسات ←</a>
    </div>
  </main>

  <style>
    .quote-book-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: var(--spacing-06) var(--spacing-05) var(--spacing-10);
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--desktop-caption);
      font-family: var(--monospace);
      color: var(--content-secondary);
      margin-bottom: var(--spacing-06);
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--content-secondary); text-decoration: none; }
    .breadcrumb a:hover { color: var(--content-primary); }

    .book-header {
      position: relative;
      display: flex;
      align-items: center;
      gap: var(--spacing-05);
      margin-bottom: var(--spacing-07);
      padding: var(--spacing-06);
      background: var(--background-secondary);
      border: 0.5px solid var(--border-muted);
      border-radius: 14px;
      overflow: hidden;
    }
    .book-header::before {
      content: "";
      position: absolute;
      inset: 0;
      height: 140px;
      background: radial-gradient(circle at 15% -20%, rgba(45, 212, 191, 0.3), transparent 65%);
      pointer-events: none;
    }
    .book-cover-lg {
      position: relative;
      width: 96px;
      height: 140px;
      object-fit: cover;
      border-radius: 6px;
      flex-shrink: 0;
      box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.5), 0 0 0 0.5px rgba(255, 255, 255, 0.1);
    }
    .book-cover-lg-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #2dd4bf;
      background: rgba(45, 212, 191, 0.12);
      font-weight: 700;
      font-size: 2.4rem;
    }
    .book-identity {
      position: relative;
      flex: 1;
      min-width: 0;
    }
    .book-badge {
      display: inline-block;
      margin-bottom: 6px;
      padding: 2px 10px;
      background: rgba(45, 212, 191, 0.14);
      border: 0.5px solid rgba(45, 212, 191, 0.35);
      color: #2dd4bf;
      border-radius: 10px;
      font-family: var(--monospace);
      font-size: 10px;
      font-weight: 700;
    }
    .book-header h1 {
      margin: 0 0 4px;
      color: var(--content-primary);
      font-size: clamp(1.3rem, 3vw, 1.85rem);
      line-height: 1.3;
    }
    .book-author-line {
      margin: 0 0 var(--spacing-02);
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
    }
    .book-author-link {
      color: DarkOrange;
      text-decoration: none;
      font-weight: 600;
    }
    .book-author-link:hover { color: #ff9d33; }
    .book-stats {
      font-family: var(--monospace);
      font-size: var(--desktop-caption);
      color: var(--content-secondary);
    }

    :global(.quote-page-ad) {
      margin-bottom: var(--spacing-07);
      padding-top: var(--spacing-05);
      border-top: 0.5px solid var(--border-muted);
    }

    .other-books {
      margin-top: var(--spacing-08);
    }
    .other-books h2 {
      margin: 0 0 var(--spacing-04) 0;
      font-size: clamp(1.05rem, 2.2vw, 1.3rem);
      color: #2dd4bf;
    }
    .other-books-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: var(--spacing-04);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .other-book-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: var(--spacing-04) var(--spacing-02);
      background: var(--background-secondary);
      border: 0.5px solid var(--border-muted);
      border-radius: 8px;
      text-decoration: none;
      text-align: center;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .other-book-card:hover {
      transform: translateY(-2px);
      border-color: #2dd4bf;
    }
    .other-book-cover {
      width: 72px;
      height: 106px;
      object-fit: cover;
      border-radius: 4px;
      background: var(--background-selected);
      box-shadow: 0px 4px 14px rgba(0, 0, 0, 0.5), 0 0 0 0.5px rgba(255, 255, 255, 0.1);
    }
    .other-book-cover-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #2dd4bf;
      background: rgba(45, 212, 191, 0.1);
      font-weight: 700;
      font-size: 1.5rem;
    }
    .other-book-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--content-primary);
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .other-book-count {
      font-family: var(--monospace);
      font-size: 10px;
      color: #2dd4bf;
    }

    .page-nav {
      margin-top: var(--spacing-07);
      padding-top: var(--spacing-05);
      border-top: 0.5px solid var(--border-muted);
    }
    .back-link {
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--content-primary); }
  </style>
</Layout>
