---
import Layout from "../../../layouts/Layout.astro";
import QuoteCard from "../../../components/QuoteCard";
import BreadcrumbSchema from "../../../components/schema/BreadcrumbSchema.astro";
import QuoteSchema from "../../../components/schema/QuoteSchema.astro";
import { getQuoteBooks } from "../../../utils/quotes";
import "../../../components/CardsContainer.css";

export async function getStaticPaths() {
  return getQuoteBooks().map((entry) => ({
    params: { book: entry.slug },
    props: { book: entry.book, author: entry.author, authorSlug: entry.authorSlug, cover: entry.cover, quotes: entry.quotes },
  }));
}

const { book, author, authorSlug, cover, quotes } = Astro.props;

const canonicalUrl = `https://elhellal.com/quotes/book/${encodeURIComponent(Astro.params.book)}/`;
const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الاقتباسات", url: "https://elhellal.com/quotes" },
  { name: book },
];
---

<Layout
  site={`الهلال - اقتباسات من ${book}`}
  title="الهلال"
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle={`اقتباسات من كتاب ${book} | الهلال`}
  pageDescription={`${quotes.length} اقتباساً من كتاب "${book}" لـ${author}، مترجماً إلى العربية.`}
  canonicalUrl={canonicalUrl}
  ogTitle={`اقتباسات من ${book} | الهلال`}
  ogDescription={`${quotes.length} اقتباساً من ${book}`}
  ogUrl={canonicalUrl}
  ogType="website"
>
  <QuoteSchema quotes={quotes} url={canonicalUrl} />
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="quote-detail-page">
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/quotes">الاقتباسات</a>
      <span aria-hidden="true">›</span>
      <span>{book}</span>
    </nav>

    <header class="quote-detail-header">
      {cover && <img src={cover} alt={book} class="quote-book-cover-lg" loading="eager" />}
      <div>
        <h1>{book}</h1>
        <p class="quote-detail-count">
          {quotes.length} اقتباساً · <a href={`/quotes/${encodeURIComponent(authorSlug)}/`} class="quote-detail-author-link">{author}</a>
        </p>
      </div>
    </header>

    <ul role="list" class="link-card-grid">
      {quotes.map((quote) => (
        <QuoteCard client:visible quote={quote} />
      ))}
    </ul>

    <div class="page-nav">
      <a href="/quotes" class="back-link">كل الاقتباسات ←</a>
    </div>
  </main>

  <style>
    .quote-detail-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: var(--spacing-06) var(--spacing-05) var(--spacing-10);
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--desktop-caption);
      font-family: var(--monospace);
      color: var(--content-secondary);
      margin-bottom: var(--spacing-06);
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--content-secondary); text-decoration: none; }
    .breadcrumb a:hover { color: var(--content-primary); }

    .quote-detail-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-04);
      margin-bottom: var(--spacing-06);
    }
    .quote-book-cover-lg {
      width: 72px;
      height: 106px;
      object-fit: cover;
      border-radius: 6px;
      flex-shrink: 0;
      box-shadow: 0px 4px 16px rgba(0, 0, 0, 0.5), 0 0 0 0.5px rgba(255, 255, 255, 0.1);
    }
    .quote-detail-author-link {
      color: var(--content-secondary);
      text-decoration: none;
    }
    .quote-detail-author-link:hover {
      color: DarkOrange;
    }
    .quote-detail-header h1 {
      margin: 0;
      color: DarkOrange;
      font-size: clamp(1.25rem, 3vw, 1.75rem);
    }
    .quote-detail-count {
      margin: 0;
      font-family: var(--monospace);
      font-size: var(--desktop-caption);
      color: var(--content-secondary);
    }

    .page-nav {
      margin-top: var(--spacing-07);
      padding-top: var(--spacing-05);
      border-top: 0.5px solid var(--border-muted);
    }
    .back-link {
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--content-primary); }
  </style>
</Layout>
