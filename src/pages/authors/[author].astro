---
import Layout from "../../layouts/Layout.astro";
import MasonryFeed from "../../components/MasonryFeed";
import ExploreTiles from "../../components/ExploreTiles.astro";
import FeedChrome from "../../components/FeedChrome.astro";
import "../../components/MasonryFeed.css";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import ItemListSchema from "../../components/schema/ItemListSchema.astro";
import PersonSchema from "../../components/schema/PersonSchema.astro";
import { getPersonalAuthors, type AuthorArticle } from "../../utils/authors";
import { categoryTiles, type ExploreTile } from "../../utils/exploreTiles";
import { getCategoryTitles } from "../../lib/feed-data";
import { toFeedCard, type FeedCard } from "../../lib/feed";
import { LISTING_SHELL_SLUG } from "../../lib/listing-page";
import { shellMarkers } from "../../lib/shell-template";

// This page renders in two modes:
// - Personal-blog (and dev-only WriteFreely) writers prerender as ordinary
//   static pages.
// - author === LISTING_SHELL_SLUG renders the page *shell* for every
//   catalog author (hundreds, growing with the data): the same markup
//   with {{tokens}} where the data goes. scripts/build-worker-data.ts moves it
//   out of dist/ and the site Worker (workers/site/) fills it per request from
//   a record in dist/_data/listings/ — derivations in listingTemplateData()
//   (src/lib/listing-page.ts), keep them in sync with the markup below. The
//   Worker also renders the MasonryFeed island itself.
export async function getStaticPaths() {
  const personal = (await getPersonalAuthors()).map((author) => ({
    params: { author: author.screen_name },
    props: {
      screen_name: author.screen_name,
      articles: author.articles,
      displayName: author.displayName,
      tagline: author.tagline,
      bio: author.bio,
      accent: author.accent,
    },
  }));
  return [{ params: { author: LISTING_SHELL_SLUG }, props: {} }, ...personal];
}

const isShell = Astro.params.author === LISTING_SHELL_SLUG;
const { open, close, eachOpen, eachClose } = shellMarkers(isShell);

interface AuthorView {
  authorLabel: string;
  canonicalUrl: string;
  nameDir: string;
  total: number | string;
  latestDate?: string | undefined;
  topCategories: Array<{ label: string; count: number | string }>;
  tiles: ExploreTile[];
  // Personal writers: initial avatar in their accent color, tagline and bio.
  isPersonal: boolean;
  accent?: string | undefined;
  initial?: string | undefined;
  tagline?: string | undefined;
  bio?: string | undefined;
  // catalog authors: photo and external profile link.
  avatar?: string | undefined;
  profileUrl?: string | undefined;
  profileLinkLabel?: string | undefined;
}

let v: AuthorView;
let personal: { screen_name: string; sorted: AuthorArticle[]; feedCards: FeedCard[] } | undefined;

if (isShell) {
  v = {
    authorLabel: "{{authorLabel}}",
    canonicalUrl: "{{canonicalUrl}}",
    nameDir: "{{nameDir}}",
    total: "{{total}}",
    latestDate: "{{latestDateAr}}",
    topCategories: [{ label: "{{.label}}", count: "{{.count}}" }],
    tiles: [],
    isPersonal: false,
    avatar: "{{avatar}}",
    profileUrl: "{{profileUrl}}",
    profileLinkLabel: "{{profileLinkLabel}}",
  };
} else {
  const { screen_name, articles, displayName, tagline, bio, accent } = Astro.props as {
    screen_name: string;
    articles: AuthorArticle[];
    displayName?: string;
    tagline?: string;
    bio?: string;
    accent?: string;
  };
  const categoryTitleMap = getCategoryTitles();

  const sorted = [...articles].sort(
    (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
  );
  // Only what a card needs — the full entries carry tldr/keywords/etc.
  personal = { screen_name, sorted, feedCards: sorted.map((a) => toFeedCard(a, a.category)) };

  // Top categories this author writes in — surfaces their range and doubles as
  // internal links back into category pages.
  const categoryCounts = new Map<string, number>();
  articles.forEach((a) => {
    const label = categoryTitleMap[a.category] || a.category;
    categoryCounts.set(label, (categoryCounts.get(label) || 0) + 1);
  });

  v = {
    authorLabel: displayName || `@${screen_name}`,
    canonicalUrl: `https://elhellal.com/authors/${encodeURIComponent(screen_name)}/`,
    nameDir: displayName ? "rtl" : "ltr",
    total: sorted.length,
    latestDate: sorted[0]
      ? new Date(sorted[0].created_at).toLocaleDateString("ar", { year: "numeric", month: "long", day: "numeric" })
      : undefined,
    topCategories: [...categoryCounts.entries()]
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5)
      .map(([label, count]) => ({ label, count })),
    tiles: categoryTiles(articles),
    isPersonal: true,
    accent,
    initial: displayName?.trim().charAt(0),
    tagline,
    bio,
  };
}

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الكتّاب", url: "https://elhellal.com/authors" },
  { name: v.authorLabel },
];
---

<Layout
  site={`الهلال - ${v.authorLabel}`}
  title="الهلال"
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle={`مقالات ${v.authorLabel} | الهلال`}
  pageDescription={`تصفح ${v.total} مقالة منشورة بواسطة ${v.authorLabel} على الهلال.`}
  canonicalUrl={v.canonicalUrl}
  ogTitle={`مقالات ${v.authorLabel} | الهلال`}
  ogDescription={`${v.total} مقالة بواسطة ${v.authorLabel}`}
  ogUrl={v.canonicalUrl}
  ogType="profile"
>
  {isShell ? (
    <Fragment>
      <script type="application/ld+json" set:html="{{{personLd}}}" />
      <script type="application/ld+json" set:html="{{{itemListLd}}}" />
      <script type="application/ld+json" set:html="{{{breadcrumbLd}}}" />
    </Fragment>
  ) : (
    <Fragment>
      <PersonSchema name={v.authorLabel} url={v.canonicalUrl} description={v.bio} />
      <ItemListSchema items={personal!.sorted} listName={`@${personal!.screen_name} Articles`} />
      <BreadcrumbSchema items={breadcrumbs} />
    </Fragment>
  )}

  <main id="main-content" class="author-page">
    <FeedChrome />
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/authors/">الكتّاب</a>
      <span aria-hidden="true">›</span>
      <span>{v.authorLabel}</span>
    </nav>

    <header class="author-header" style={v.isPersonal ? `--author-accent:${v.accent}` : ""}>
      <div class="author-header-top">
        {v.isPersonal ? (
          <span class="author-avatar-lg author-avatar-initial" style={`background:${v.accent}`}>
            {v.initial}
          </span>
        ) : (
          <img
            src={v.avatar}
            alt={v.authorLabel}
            class="author-avatar-lg"
            onerror="this.src='/favicons/default.png'"
            loading="eager"
          />
        )}
        <div class="author-identity">
          <h1 style={v.isPersonal ? `color:${v.accent}` : ""} dir={v.nameDir}>{v.authorLabel}</h1>
          {v.isPersonal && v.tagline && <p class="author-tagline">{v.tagline}</p>}
          <div class="author-stats">
            <span class="author-stat">{v.total} مقالة</span>
            {v.latestDate && (
              <>
                <Fragment set:html={open("latestDateAr")} />
                <span class="stat-dot" aria-hidden="true">·</span>
                <span class="author-stat">آخر نشر {v.latestDate}</span>
                <Fragment set:html={close("latestDateAr")} />
              </>
            )}
          </div>
        </div>
        {!v.isPersonal && (
          <a href={v.profileUrl} target="_blank" rel="noopener noreferrer" class="author-profile-link">
            {v.profileLinkLabel}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256">
              <path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/>
            </svg>
          </a>
        )}
      </div>

      {v.isPersonal && v.bio && <p class="author-bio">{v.bio}</p>}

      {v.topCategories.length > 0 && (
        <>
          <Fragment set:html={open("topCategories")} />
          <div class="author-categories" aria-label="التصنيفات">
            <Fragment set:html={eachOpen("topCategories")} />
            {v.topCategories.map((c) => (
              <span class="author-category-pill">{c.label} <span class="pill-count">{c.count}</span></span>
            ))}
            <Fragment set:html={eachClose("topCategories")} />
          </div>
          <Fragment set:html={close("topCategories")} />
        </>
      )}
    </header>

    <ExploreTiles
      shell={isShell}
      tiles={v.tiles}
      heading="يكتب في"
      moreLabel="كل التصنيفات"
      lessLabel="أقل"
    />
    {isShell ? (
      <MasonryFeed client:idle cards={[]} categoryTitles={{}} />
    ) : (
      <MasonryFeed client:idle cards={personal!.feedCards} categoryTitles={getCategoryTitles()} />
    )}

    <div class="page-nav">
      <a href="/authors/" class="back-link">كل الكتّاب →</a>
    </div>
  </main>

  <style>
    .author-page {
      padding-bottom: var(--spacing-10);
    }

    .author-page .breadcrumb {
      margin-top: var(--spacing-06);
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--desktop-caption);
      font-family: var(--monospace);
      color: var(--content-secondary);
      margin-bottom: var(--spacing-06);
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--content-secondary); text-decoration: none; }
    .breadcrumb a:hover { color: var(--content-primary); }

    .author-header {
      --author-accent: DarkOrange;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-04);
      margin-bottom: var(--spacing-08);
      padding: var(--spacing-06);
      background: var(--background-secondary);
      border: 0.5px solid var(--border-muted);
      border-radius: 14px;
      overflow: hidden;
    }
    .author-header::before {
      content: "";
      position: absolute;
      inset: 0;
      height: 120px;
      background: radial-gradient(circle at 15% -20%, color-mix(in srgb, var(--author-accent) 35%, transparent), transparent 65%);
      pointer-events: none;
    }
    .author-header-top {
      position: relative;
      display: flex;
      align-items: center;
      gap: var(--spacing-05);
    }
    .author-avatar-lg {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--background-selected);
      flex-shrink: 0;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--author-accent) 45%, transparent);
    }
    .author-avatar-initial {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
      font-size: 2rem;
    }
    .author-identity {
      flex: 1;
      min-width: 0;
    }
    .author-header h1 {
      margin: 0;
      color: DarkOrange;
      font-size: clamp(1.35rem, 3.2vw, 1.9rem);
      direction: rtl;
      text-align: right;
    }
    .author-header h1[dir="ltr"] {
      direction: ltr;
    }
    .author-tagline {
      margin: 4px 0 0;
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
    }
    .author-stats {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: var(--spacing-02);
      font-family: var(--monospace);
      font-size: var(--desktop-caption);
      color: var(--content-secondary);
      flex-wrap: wrap;
    }
    .stat-dot { opacity: 0.5; }
    .author-profile-link {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--author-accent);
      color: var(--background-high-contrast);
      font-weight: 600;
      font-size: var(--desktop-body-sm);
      text-decoration: none;
      border-radius: 6px;
      transition: filter 0.15s;
    }
    .author-profile-link:hover { filter: brightness(1.1); }
    .author-bio {
      position: relative;
      margin: 0;
      max-width: 65ch;
      font-size: var(--desktop-body-sm);
      line-height: 1.7;
      color: var(--content-secondary);
    }
    .author-categories {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .author-category-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      background: rgba(255,255,255,0.05);
      border: 0.5px solid var(--border-muted);
      border-radius: 20px;
      font-family: var(--monospace);
      font-size: 11px;
      color: var(--content-secondary);
    }
    .pill-count {
      color: var(--author-accent);
      font-weight: 600;
    }
    @media (max-width: 560px) {
      .author-header-top { flex-wrap: wrap; }
      .author-profile-link { margin-inline-start: auto; }
    }

    .page-nav {
      margin-top: var(--spacing-07);
      padding-top: var(--spacing-05);
      border-top: 0.5px solid var(--border-muted);
    }
    .back-link {
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--content-primary); }
  </style>
</Layout>
