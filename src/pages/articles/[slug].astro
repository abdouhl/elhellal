---
import Layout from "../../layouts/Layout.astro";
import ArticleSchema from "../../components/schema/ArticleSchema.astro";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import BookmarkButton from "../../components/BookmarkButton";
import AdUnit from "../../components/AdUnit.astro";
import { getCollection } from "astro:content";
import { personalBlogs, PERSONAL_COLLECTIONS, type PersonalBlogPerson } from "../../data/personal-blogs";
import { getPlaceholderImage } from "../../utils/placeholderImage";
import { ARTICLE_SHELL_SLUG } from "../../lib/article-page";
import { shellMarkers } from "../../lib/shell-template";

// This page renders in two modes:
// - Personal-blog posts (src/content/*) prerender as ordinary static pages.
// - slug === ARTICLE_SHELL_SLUG renders the article *shell*: the same markup
//   with {{tokens}} where the data goes. scripts/build-worker-data.ts moves it
//   out of dist/ and the site Worker (workers/site/) fills it per request for
//   every articles.json article, from static JSON shards. Prerendering those
//   (100k+) would blow past Cloudflare's file-count and build limits.
//   Their data derivations live in articleTemplateData()
//   (src/lib/article-page.ts) — keep it in sync with the markup below.
export async function getStaticPaths() {
  const personalPostLists = await Promise.all(
    PERSONAL_COLLECTIONS.map((c) => getCollection(c))
  );
  const personalPaths = personalPostLists.flat().map((post) => ({
    params: { slug: post.slug },
  }));

  return [{ params: { slug: ARTICLE_SHELL_SLUG } }, ...personalPaths];
}

export const prerender = true;

const { slug } = Astro.params;
const isShell = slug === ARTICLE_SHELL_SLUG;
const { open, close, eachOpen, eachClose } = shellMarkers(isShell);
const T = (name: string) => `{{${name}}}`;

interface RelatedCard { href: string; image: string; title: string; author: string }

interface ArticleView {
  seoTitle: string;
  seoDescription: string;
  canonicalUrl: string;
  ogImage?: string | undefined;
  twitterCreator?: string | undefined;
  keywordsString?: string | undefined;
  slug: string;
  title: string;
  preview_text: string;
  original_img_url?: string | undefined;
  screen_name?: string | undefined;
  created_at: string;
  dateAr: string;
  categoryHref: string;
  categoryTitle: string;
  fallbackPath: string;
  authorHref: string;
  authorDisplayName: string;
  authorUrl: string;
  authorSubLabel: string;
  avatar?: string | undefined;
  readUrl?: string | undefined;
  isSubstack: boolean;
  tag?: string | undefined;
  tldr?: string | undefined;
  whyThisMatters?: string | undefined;
  whoItems: Array<{ text: string }>;
  hasCore: boolean;
  keywords: Array<{ label: string; href: string }>;
  xShareUrl: string;
  linkedinShareUrl: string;
  redditShareUrl: string;
  related: RelatedCard[];
  relatedHeading: string;
}

let isPersonalPost = false;
let person: PersonalBlogPerson | undefined;
let PersonContent: any;
let v: ArticleView;

if (isShell) {
  // Every value is a token; the Worker substitutes per article.
  v = {
    seoTitle: T("seoTitle"),
    seoDescription: T("seoDescription"),
    canonicalUrl: T("canonicalUrl"),
    ogImage: T("ogImage"),
    twitterCreator: T("twitterCreator"),
    keywordsString: T("keywordsString"),
    slug: T("slug"),
    title: T("title"),
    preview_text: T("preview_text"),
    original_img_url: T("original_img_url"),
    screen_name: T("screen_name"),
    created_at: T("created_at"),
    dateAr: T("dateAr"),
    categoryHref: T("categoryHref"),
    categoryTitle: T("categoryTitle"),
    fallbackPath: T("fallbackPath"),
    authorHref: T("authorHref"),
    authorDisplayName: T("authorDisplayName"),
    authorUrl: T("authorUrl"),
    authorSubLabel: T("authorSubLabel"),
    avatar: T("avatar"),
    readUrl: T("readUrl"),
    isSubstack: true,
    tag: T("tag"),
    tldr: T("tldr"),
    whyThisMatters: T("whyThisMatters"),
    whoItems: [{ text: T(".text") }],
    hasCore: true,
    keywords: [{ label: T(".label"), href: T(".href") }],
    xShareUrl: T("xShareUrl"),
    linkedinShareUrl: T("linkedinShareUrl"),
    redditShareUrl: T("redditShareUrl"),
    related: [{ href: T(".href"), image: T(".image"), title: T(".title"), author: T(".author") }],
    relatedHeading: `المزيد في ${T("categoryTitle")}`,
  };
} else {
  let found: any;
  for (const key of PERSONAL_COLLECTIONS) {
    const posts = await getCollection(key);
    found = posts.find((p) => p.slug === slug);
    if (found) {
      isPersonalPost = true;
      person = personalBlogs[key]!;
      PersonContent = (await found.render()).Content;
      const otherPosts = posts
        .filter((p) => p.slug !== slug)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .slice(0, 3);
      const canonicalUrl = `https://elhellal.com/articles/${encodeURIComponent(found.slug)}/`;
      const authorHref = `/authors/${person.slug}/`;
      const encodedShareText = encodeURIComponent(
        `اكتشف "${found.data.title}" — مقالة رائعة وجدتها على الهلال! ${canonicalUrl}`
      );
      const encodedCanonicalUrl = encodeURIComponent(canonicalUrl);
      v = {
        seoTitle: found.data.title,
        seoDescription: found.data.description,
        canonicalUrl,
        // No placeholder fallback here on purpose: the article page shows no
        // cover image at all when there's no real thumb (see .article-cover
        // below). Related cards still fall back to a placeholder.
        ogImage: found.data.large || found.data.thumb,
        slug: found.slug,
        title: found.data.title,
        preview_text: found.data.description,
        original_img_url: found.data.large || found.data.thumb,
        screen_name: person.slug,
        created_at: found.data.pubDate.toISOString().slice(0, 10),
        dateAr: found.data.pubDate.toLocaleDateString("ar", { year: "numeric", month: "long", day: "numeric" }),
        categoryHref: authorHref,
        categoryTitle: person.nameAr,
        fallbackPath: authorHref,
        authorHref,
        authorDisplayName: person.nameAr,
        authorUrl: authorHref,
        authorSubLabel: person.tagline,
        isSubstack: false,
        whoItems: [],
        hasCore: false,
        keywords: [],
        xShareUrl: `https://x.com/intent/post?text=${encodedShareText}&url=${encodedCanonicalUrl}`,
        linkedinShareUrl: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedCanonicalUrl}`,
        redditShareUrl: `https://www.reddit.com/submit?url=${encodedCanonicalUrl}&title=${encodedShareText}`,
        related: otherPosts.map((p) => ({
          href: `/articles/${encodeURIComponent(p.slug)}/`,
          image: p.data.large || p.data.thumb || getPlaceholderImage(),
          title: p.data.title,
          author: person!.nameAr,
        })),
        relatedHeading: `مقالات أخرى لـ ${person.nameAr}`,
      };
      break;
    }
  }
  if (!found) {
    throw new Error(`Article not found: ${slug}`);
  }
}

const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: v!.categoryTitle, url: `https://elhellal.com${v!.categoryHref}` },
  { name: v!.title },
];
---

<Layout
  site="الهلال"
  title={v.seoTitle}
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle={v.seoTitle}
  pageDescription={v.seoDescription}
  canonicalUrl={v.canonicalUrl}
  ogTitle={v.seoTitle}
  ogDescription={v.seoDescription}
  ogUrl={v.canonicalUrl}
  ogImage={v.ogImage}
  ogType="article"
  ogSiteName="الهلال"
  twitterCard="summary_large_image"
  twitterTitle={v.seoTitle}
  twitterDescription={v.seoDescription}
  twitterImage={v.ogImage}
  twitterCreator={v.twitterCreator}
  keywords={v.keywordsString}
>
  {isShell && (
    <Fragment
      slot="head"
      set:html={`${open("defaultOgImage")}<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">${close("defaultOgImage")}`}
    />
  )}
  {isShell ? (
    <Fragment>
      <script type="application/ld+json" set:html="{{{articleLd}}}" />
      <script type="application/ld+json" set:html="{{{breadcrumbLd}}}" />
    </Fragment>
  ) : (
    <Fragment>
      <ArticleSchema
        headline={v.title}
        description={v.preview_text}
        url={v.canonicalUrl}
        image={v.original_img_url}
        datePublished={v.created_at}
        authorName={v.authorDisplayName}
        authorUrl={`https://elhellal.com${v.authorHref}`}
      />
      <BreadcrumbSchema items={breadcrumbs} />
    </Fragment>
  )}

  <main id="main-content" class="article-page">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href={v.categoryHref}>{v.categoryTitle}</a>
      <span aria-hidden="true">›</span>
      <span>{v.title}</span>
    </nav>

    <div class="article-layout">

      <!-- LEFT: Main article card -->
      <article class="article-card" itemscope itemtype="https://schema.org/Article">

        <!-- Cover image (omitted entirely when the article has no thumb — no placeholder here) -->
        {(isShell || v.original_img_url) && (
          <Fragment>
            <Fragment set:html={open("original_img_url")} />
            <div class="article-cover">
              <img
                src={v.original_img_url}
                alt={v.title}
                class="article-cover-img"
                itemprop="image"
                loading="eager"
                onerror="this.closest('.article-cover').style.display='none'"
              />
              <div class="article-cover-tags">
                <a href={v.categoryHref} class="cover-tag">{v.categoryTitle}</a>
                {!isPersonalPost && v.screen_name && (
                  <Fragment>
                    <Fragment set:html={open("screen_name")} />
                    <span class="cover-tag">{v.authorDisplayName}</span>
                    <Fragment set:html={close("screen_name")} />
                  </Fragment>
                )}
              </div>
            </div>
            <Fragment set:html={close("original_img_url")} />
          </Fragment>
        )}

        <!-- Article body -->
        <div class="article-body">

          <header class="article-header">
            {(isShell || !v.original_img_url) && (
              <Fragment>
                <Fragment set:html={open("!original_img_url")} />
                <div class="article-tags-standalone">
                  <a href={v.categoryHref} class="cover-tag cover-tag-standalone">{v.categoryTitle}</a>
                  {!isPersonalPost && v.screen_name && (
                    <Fragment>
                      <Fragment set:html={open("screen_name")} />
                      <span class="cover-tag cover-tag-standalone">{v.authorDisplayName}</span>
                      <Fragment set:html={close("screen_name")} />
                    </Fragment>
                  )}
                </div>
                <Fragment set:html={close("!original_img_url")} />
              </Fragment>
            )}
            <h1 class="article-title" itemprop="headline">{v.title}</h1>
            <div class="article-meta">
              <time datetime={v.created_at} itemprop="datePublished">{v.dateAr}</time>
              {v.screen_name && (
                <Fragment>
                  <Fragment set:html={open("screen_name")} />
                  <span class="meta-dot">·</span>
                  <a
                    href={v.authorHref}
                    class="meta-author"
                    itemprop="author"
                  >
                    {v.authorDisplayName}
                  </a>
                  <Fragment set:html={close("screen_name")} />
                </Fragment>
              )}
            </div>
          </header>

          <!-- Keywords -->
          {v.keywords.length > 0 && (
            <Fragment>
              <Fragment set:html={open("keywords")} />
              <div class="article-keywords" aria-label="الكلمات المفتاحية">
                <Fragment set:html={eachOpen("keywords")} />
                {v.keywords.map((kw) => (
                  <Fragment>
                    {(isShell || kw.href) && (
                      <Fragment>
                        <Fragment set:html={open(".href")} />
                        <a href={kw.href} class="keyword-tag">{kw.label}</a>
                        <Fragment set:html={close(".href")} />
                      </Fragment>
                    )}
                    {(isShell || !kw.href) && (
                      <Fragment>
                        <Fragment set:html={open("!.href")} />
                        <span class="keyword-tag keyword-tag--static" title="لا توجد صفحة كافية من المقالات لهذا الوسم بعد">{kw.label}</span>
                        <Fragment set:html={close("!.href")} />
                      </Fragment>
                    )}
                  </Fragment>
                ))}
                <Fragment set:html={eachClose("keywords")} />
              </div>
              <Fragment set:html={close("keywords")} />
            </Fragment>
          )}

          <!-- About section -->
          <section class="article-about" aria-label="About this article">
            {(isShell || v.preview_text) && (
              <Fragment>
                <Fragment set:html={open("preview_text")} />
                <p class="article-summary" itemprop="description">{v.preview_text}</p>
                <Fragment set:html={close("preview_text")} />
              </Fragment>
            )}
          </section>

          <!-- Full article body — personal-blog posts render their own markdown content -->
          {isPersonalPost && PersonContent && (
            <div class="article-prose" itemprop="articleBody">
              <PersonContent />
            </div>
          )}

          <!-- Core Structure — renders only when fields are present -->
          {v.hasCore && (
            <Fragment>
              <Fragment set:html={open("hasCore")} />
              <div class="core-sections">

                <Fragment set:html={open("tldr")} />
                <div class="core-section">
                  <p class="core-label">
                    <span class="core-emoji">⚡</span> ملخص
                  </p>
                  <p class="core-body">{v.tldr}</p>
                </div>
                <Fragment set:html={close("tldr")} />

                <Fragment set:html={open("whyThisMatters")} />
                <div class="core-section">
                  <p class="core-label">
                    <span class="core-emoji">🎯</span> لماذا يهمك هذا
                  </p>
                  <p class="core-body">{v.whyThisMatters}</p>
                </div>
                <Fragment set:html={close("whyThisMatters")} />

                <Fragment set:html={open("whoItems")} />
                <div class="core-section">
                  <p class="core-label">
                    <span class="core-emoji">👥</span> من يجب أن يقرأ هذا
                  </p>
                  <ul class="core-list">
                    <Fragment set:html={eachOpen("whoItems")} />
                    {v.whoItems.map((item) => (
                      <li>{item.text}</li>
                    ))}
                    <Fragment set:html={eachClose("whoItems")} />
                  </ul>
                </div>
                <Fragment set:html={close("whoItems")} />

              </div>
              <Fragment set:html={close("hasCore")} />
            </Fragment>
          )}

          <!-- In-article ad — sits at a natural reading break, after the summary/before the CTA -->
          <AdUnit slot="8525183818" format="fluid" layout="in-article" className="article-ad" />

          <!-- CTA -->
          <div class="article-cta">
            {!isPersonalPost && (
              <Fragment>
                <Fragment set:html={open("readUrl")} />
                <a
                  href={v.readUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-read"
                  itemprop="url"
                >
                  <Fragment set:html={open("isSubstack")} />
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256">
                    <path d="M224,104a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,104Zm8,56a8,8,0,0,1-8,8H32a8,8,0,0,1,0-16H224A8,8,0,0,1,232,160ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16Z"/>
                  </svg>
                  <Fragment set:html={close("isSubstack")} />
                  اقرأ المقال
                </a>
                <Fragment set:html={close("readUrl")} />
                <Fragment set:html={open("!readUrl")} />
                <span class="btn-read btn-disabled">لا يوجد رابط</span>
                <Fragment set:html={close("!readUrl")} />
              </Fragment>
            )}
            <BookmarkButton
              client:load
              slug={isShell ? "{{jt:slug}}" : v.slug}
              title={isShell ? "{{jt:title}}" : v.title}
              variant="default"
            />
          </div>

          <!-- Share -->
          <div class="article-share">
            <span class="share-label">مشاركة</span>
            <div class="share-buttons">
              <a href={v.xShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on X" aria-label="Share on X">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
                  <path d="M214.75,211.71l-62.6-98.38,61.77-67.95a8,8,0,0,0-11.84-10.76L143.24,99.34,102.75,35.71A8,8,0,0,0,96,32H48a8,8,0,0,0-6.75,12.3l62.6,98.37-61.77,68a8,8,0,1,0,11.84,10.76l58.84-64.72,40.49,63.63A8,8,0,0,0,160,224h48a8,8,0,0,0,6.75-12.29ZM164.39,208,62.57,48h29L193.43,208Z"/>
                </svg>
              </a>
              <a href={v.linkedinShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on LinkedIn" aria-label="Share on LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
                  <path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24Zm0,192H40V40H216V216ZM96,112v64a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm88,28v36a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140ZM100,84A12,12,0,1,1,88,72,12,12,0,0,1,100,84Z"/>
                </svg>
              </a>
              <a href={v.redditShareUrl} target="_blank" rel="noopener noreferrer" class="share-btn" title="Share on Reddit" aria-label="Share on Reddit">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
                  <path d="M248,104a32,32,0,0,0-52.94-24.19c-16.75-8.9-36.76-14.28-57.66-15.53l5.19-31.17,17.72,2.72a24,24,0,1,0,2.87-15.74l-26-4a8,8,0,0,0-9.11,6.59L121.2,64.16c-21.84.94-42.82,6.38-60.26,15.65a32,32,0,0,0-42.59,47.74A59,59,0,0,0,16,144c0,21.93,12,42.35,33.91,57.49C70.88,216,98.61,224,128,224s57.12-8,78.09-22.51C228,186.35,240,165.93,240,144a59,59,0,0,0-2.35-16.45A32.16,32.16,0,0,0,248,104ZM184,24a8,8,0,1,1-8,8A8,8,0,0,1,184,24Zm40.13,93.78a8,8,0,0,0-3.29,10A43.58,43.58,0,0,1,224,144c0,16.53-9.59,32.27-27,44.33C178.67,201,154.17,208,128,208s-50.67-7-69-19.67C41.59,176.27,32,160.53,32,144a43.75,43.75,0,0,1,3.14-16.17,8,8,0,0,0-3.27-10A16,16,0,1,1,52.94,94.59a8,8,0,0,0,10.45,2.23l.36-.22C81.45,85.9,104.25,80,128,80h0c23.73,0,46.53,5.9,64.23,16.6l.42.25a8,8,0,0,0,10.39-2.26,16,16,0,1,1,21.07,23.19ZM88,144a16,16,0,1,1,16-16A16,16,0,0,1,88,144Zm96-16a16,16,0,1,1-16-16A16,16,0,0,1,184,128Zm-16.93,44.25a8,8,0,0,1-3.32,10.82,76.18,76.18,0,0,1-71.5,0,8,8,0,1,1,7.5-14.14,60.18,60.18,0,0,0,56.5,0A8,8,0,0,1,167.07,172.25Z"/>
                </svg>
              </a>
              <button class="share-btn" id="copyLinkBtn" title="Copy link" aria-label="Copy link to clipboard">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
                  <path d="M240,88.23a54.43,54.43,0,0,1-16,37L189.25,160a54.27,54.27,0,0,1-38.63,16h-.05A54.63,54.63,0,0,1,96,119.84a8,8,0,0,1,16,.45A38.62,38.62,0,0,0,150.58,160h0a38.39,38.39,0,0,0,27.31-11.31l34.75-34.75a38.63,38.63,0,0,0-54.63-54.63l-11,11A8,8,0,0,1,135.7,59l11-11A54.65,54.65,0,0,1,224,48,54.86,54.86,0,0,1,240,88.23ZM109,185.66l-11,11A38.41,38.41,0,0,1,70.6,208h0a38.63,38.63,0,0,1-27.29-65.94L78,107.31A38.63,38.63,0,0,1,144,135.71a8,8,0,0,0,16,.45A54.86,54.86,0,0,0,144,96a54.65,54.65,0,0,0-77.27,0L32,130.75A54.62,54.62,0,0,0,70.56,224h0a54.28,54.28,0,0,0,38.64-16l11-11A8,8,0,0,0,109,185.66Z"/>
                </svg>
              </button>
            </div>
          </div>

        </div>
      </article>

      <!-- RIGHT: Sidebar -->
      <aside class="article-sidebar">

        <!-- Author card -->
        <div class="sidebar-card">
          <p class="sidebar-label">الكاتب</p>
          <div class="author-row">
            {isPersonalPost ? (
              <span class="author-avatar author-avatar-initial" style={`background:${person!.accent}`}>
                {person!.nameAr.trim().charAt(0)}
              </span>
            ) : (
              <img
                src={v.avatar}
                alt={`@${v.screen_name}`}
                class="author-avatar"
                onerror="this.src='/favicons/default.png'"
                loading="lazy"
              />
            )}
            <div>
              <a
                href={v.authorHref}
                class="author-handle"
              >
                {v.authorDisplayName}
              </a>
              {isPersonalPost ? (
                <a href={v.authorHref} class="author-sub">
                  {v.authorSubLabel}
                </a>
              ) : (
                <a
                  href={v.authorUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="author-sub"
                >
                  {v.authorSubLabel}
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Details card -->
        <div class="sidebar-card">
          <p class="sidebar-label">تفاصيل</p>
          <dl class="detail-list">
            <div class="detail-row">
              <dt>{isPersonalPost ? 'الكاتب' : 'التصنيف'}</dt>
              <dd><a href={v.categoryHref} class="detail-link">{v.categoryTitle}</a></dd>
            </div>
            <div class="detail-row">
              <dt>تاريخ النشر</dt>
              <dd>{v.dateAr}</dd>
            </div>
            {v.tag && (
              <Fragment>
                <Fragment set:html={open("tag")} />
                <div class="detail-row">
                  <dt>الوسم</dt>
                  <dd>{v.tag}</dd>
                </div>
                <Fragment set:html={close("tag")} />
              </Fragment>
            )}
          </dl>
        </div>

        <!-- Sidebar ad (elhellal square) -->
        <div class="adsense-slot" aria-label="Advertisement">
          <AdUnit slot="2951250905" minHeight={250} />
        </div>

      </aside>
    </div>

    <!-- Related articles -->
    {v.related.length > 0 && (
      <Fragment>
        <Fragment set:html={open("related")} />
        <section class="related-section" aria-label="Related articles">
          <h2 class="related-heading">{v.relatedHeading}</h2>
          <div class="related-grid">
            <Fragment set:html={eachOpen("related")} />
            {v.related.map((t) => (
              <a href={t.href} class="related-card">
                <div class="related-cover">
                  <img
                    src={t.image}
                    alt={t.title}
                    class="related-img"
                    loading="lazy"
                    onerror="this.src='/favicons/default.png'"
                  />
                  <span class="related-tag">{v.categoryTitle}</span>
                </div>
                <div class="related-body">
                  <strong class="related-title">{t.title}</strong>
                  {t.author && (
                    <Fragment>
                      <Fragment set:html={open(".author")} />
                      <span class="related-author">{t.author}</span>
                      <Fragment set:html={close(".author")} />
                    </Fragment>
                  )}
                </div>
              </a>
            ))}
            <Fragment set:html={eachClose("related")} />
          </div>
        </section>
        <Fragment set:html={close("related")} />
      </Fragment>
    )}

    <div class="page-nav">
      <a href={v.fallbackPath} class="back-link">العودة إلى {v.categoryTitle} →</a>
    </div>

  </main>

  <script type="module">
    const copyBtn = document.getElementById("copyLinkBtn");
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          setTimeout(() => (copyBtn.innerHTML = original), 2000);
        });
      });
    }
  </script>

  <!-- View-tracking beacon — feeds the "الأكثر قراءة" leaderboard. Silently
       no-ops if the elhellal-views worker isn't deployed/routed yet. -->
  <script type="module" data-astro-rerun>
    import { VIEWS_API_BASE } from "../../config/views";

    const match = window.location.pathname.match(/^\/articles\/([^/]+)\/?$/);
    if (match) {
      const slug = match[1];
      let alreadyTracked = false;
      try {
        alreadyTracked = !!sessionStorage.getItem(`viewed:${slug}`);
      } catch {}

      if (!alreadyTracked) {
        fetch(`${VIEWS_API_BASE}/track-view`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug }),
          keepalive: true,
        })
          .then(() => {
            try {
              sessionStorage.setItem(`viewed:${slug}`, "1");
            } catch {}
          })
          .catch(() => {});
      }
    }
  </script>

  <style>
