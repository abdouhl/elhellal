---
import Layout from "../layouts/Layout.astro";
import MasonryFeed from "../components/MasonryFeed";
import ExploreTiles from "../components/ExploreTiles.astro";
import FeedChrome from "../components/FeedChrome.astro";
import "../components/MasonryFeed.css";
import ItemListSchema from "../components/schema/ItemListSchema.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import data from "../data/articles.json";
import { getPersonalBlogFeedArticles } from "../utils/personalBlogFeed";
import { categoryArticles, categoryTiles, tagTiles } from "../utils/exploreTiles";

export function getStaticPaths() {
  // Derive paths from data instead of hardcoding
  return data.articles.map((cat: any) => ({
    params: { category: cat.category }
  }));
}

const { category } = Astro.params;

// Get tools for this category
const categoryData = data.articles.find((cat: any) => cat.category === category);
const categoryTools = categoryData?.content || [];
const categoryTitle = categoryData?.title || category;
const personalBlogArticles = (await getPersonalBlogFeedArticles()).filter(
  (article) => article.category === category
);

// Tags narrow the category down; small categories with too few tags fall back
// to the other categories so the block never disappears.
const tags = tagTiles(categoryArticles(category));
const useTags = tags.length >= 4;
const tiles = useTags
  ? tags
  : categoryTiles().filter((tile) => tile.href !== `/${category}/`);

// Breadcrumb data
const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: categoryTitle },
];
---

<Layout
  site={`الهلال - ${categoryTitle}`}
  title="الهلال"
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle={`أفضل مقالات ${categoryTitle} – مقالات منتقاة | الهلال`}
  pageDescription={`استكشف أفضل المقالات العربية في تصنيف ${categoryTitle} من مختلف المصادر. محتوى عربي عالي الجودة منتقى بعناية.`}
  showSearch={true}
  searchPlaceholder={`ابحث في ${categoryTitle}...`}
>
  <ItemListSchema items={categoryTools} listName={`${categoryTitle} Articles`} />
  <BreadcrumbSchema items={breadcrumbs} />
  <main id="main-content">
    <FeedChrome />
    {useTags ? (
      <ExploreTiles tiles={tiles} />
    ) : (
      <ExploreTiles
        tiles={tiles}
        heading="استكشف التصنيفات"
        moreLabel="المزيد من التصنيفات"
        lessLabel="تصنيفات أقل"
      />
    )}
    <MasonryFeed client:load filter={category} extraArticles={personalBlogArticles} />
  </main>
</Layout>
