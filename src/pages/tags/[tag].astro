---
import Layout from "../../layouts/Layout.astro";
import MasonryFeed from "../../components/MasonryFeed";
import ExploreTiles from "../../components/ExploreTiles.astro";
import FeedChrome from "../../components/FeedChrome.astro";
import "../../components/MasonryFeed.css";
import BreadcrumbSchema from "../../components/schema/BreadcrumbSchema.astro";
import ItemListSchema from "../../components/schema/ItemListSchema.astro";
import { getQualifyingTags, type TaggedArticle } from "../../utils/tags";
import { tagTiles } from "../../utils/exploreTiles";
import { getCategoryTitles } from "../../lib/feed-data";
import { toFeedCard } from "../../lib/feed";

export async function getStaticPaths() {
  return getQualifyingTags().map((tag) => ({
    params: { tag: tag.slug },
    props: { label: tag.label, articles: tag.articles },
  }));
}

const { label, articles } = Astro.props as { label: string; articles: TaggedArticle[] };

const sorted = [...articles].sort(
  (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
);

// An article listing the same keyword twice is indexed twice; show it once.
const seen = new Set<string>();
const cards = sorted
  .filter((a) => a.slug && !seen.has(a.slug) && !!seen.add(a.slug))
  .map((a) => toFeedCard(a, a.category));
const categoryTitles = getCategoryTitles();
// Tags that show up alongside this one
const related = tagTiles(articles, [Astro.params.tag]);

const canonicalUrl = `https://elhellal.com/tags/${encodeURIComponent(Astro.params.tag)}/`;
const breadcrumbs = [
  { name: "الرئيسية", url: "https://elhellal.com" },
  { name: "الوسوم", url: "https://elhellal.com/tags" },
  { name: label },
];
---

<Layout
  site={`الهلال - ${label}`}
  title="الهلال"
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle={`مقالات عن ${label} | الهلال`}
  pageDescription={`أفضل المقالات العربية المتعلقة بـ"${label}" — ${sorted.length} مقالة منتقاة بعناية من مصادر متعددة.`}
  canonicalUrl={canonicalUrl}
  ogTitle={`مقالات عن ${label} | الهلال`}
  ogDescription={`${sorted.length} مقالة عربية منتقاة عن ${label}`}
  ogUrl={canonicalUrl}
  ogType="website"
>
  <ItemListSchema items={sorted} listName={`${label} Articles`} />
  <BreadcrumbSchema items={breadcrumbs} />

  <main id="main-content" class="tag-page">
    <FeedChrome />
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/tags/">الوسوم</a>
      <span aria-hidden="true">›</span>
      <span>{label}</span>
    </nav>

    <header class="tag-header">
      <h1>#{label}</h1>
      <p class="tag-count">{sorted.length} مقالة</p>
    </header>

    <ExploreTiles tiles={related} heading="وسوم ذات صلة" />
    <MasonryFeed client:load cards={cards} categoryTitles={categoryTitles} />

    <div class="page-nav">
      <a href="/tags/" class="back-link">كل الوسوم →</a>
    </div>
  </main>

  <style>
    .tag-page {
      padding-bottom: var(--spacing-10);
    }

    .tag-page .breadcrumb {
      margin-top: var(--spacing-06);
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--desktop-caption);
      font-family: var(--monospace);
      color: var(--content-secondary);
      margin-bottom: var(--spacing-06);
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--content-secondary); text-decoration: none; }
    .breadcrumb a:hover { color: var(--content-primary); }

    .tag-header {
      display: flex;
      align-items: baseline;
      gap: var(--spacing-03);
      margin-bottom: var(--spacing-06);
    }
    .tag-header h1 {
      margin: 0;
      color: DarkOrange;
      font-size: clamp(1.25rem, 3vw, 1.75rem);
    }
    .tag-count {
      margin: 0;
      font-family: var(--monospace);
      font-size: var(--desktop-caption);
      color: var(--content-secondary);
    }

    .page-nav {
      margin-top: var(--spacing-07);
      padding-top: var(--spacing-05);
      border-top: 0.5px solid var(--border-muted);
    }
    .back-link {
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--content-primary); }
  </style>
</Layout>
