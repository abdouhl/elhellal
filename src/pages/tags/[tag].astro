---
import Layout from "../../layouts/Layout.astro";
import MasonryFeed from "../../components/MasonryFeed";
import ExploreTiles from "../../components/ExploreTiles.astro";
import FeedChrome from "../../components/FeedChrome.astro";
import SisterStrip from "../../components/SisterStrip.astro";
import "../../components/MasonryFeed.css";
import { LISTING_SHELL_SLUG } from "../../lib/listing-page";

// Tag pages (one per tag with MIN_TAG_ARTICLES+ articles — thousands, and
// growing with the data) aren't prerendered: this renders only the page's
// *shell*, with {{tokens}} where the data goes (src/lib/shell-template.ts).
// scripts/build-worker-data.ts moves it out of dist/ and the site Worker
// (workers/site/) fills it per request from a record in dist/_data/listings/
// — derivations in listingTemplateData() (src/lib/listing-page.ts), keep
// them in sync with the markup below. The Worker also renders the
// MasonryFeed island itself (the build swaps its props and HTML for tokens).
export function getStaticPaths() {
  return [{ params: { tag: LISTING_SHELL_SLUG } }];
}

// One paragraph of text that's unique to each tag, so a tag page isn't only a
// grid of cards: how many articles and writers, the newest date, and links to
// the top writers' and categories' pages (writers/categories are #each lists
// with a precomputed "، " / " و" separator).
const intro =
  "تجمع هذه الصفحة {{articlesPhrase}} منتقاة عن «{{label}}»" +
  "<!--#if writersPhrase--> {{writersPhrase}}<!--/if writersPhrase-->" +
  "<!--#if latestDateAr-->، آخرها نُشر في {{latestDateAr}}<!--/if latestDateAr-->." +
  "<!--#if writers--> من أبرز من كتب فيه: <!--#each writers-->{{.sep}}<a href=\"{{.href}}\">{{.name}}</a><!--/each writers-->.<!--/if writers-->" +
  "<!--#if categories--> {{categoriesLead}} <!--#each categories-->{{.sep}}<a href=\"{{.href}}\">{{.title}}</a><!--/each categories-->.<!--/if categories-->";
---

<Layout
  site="الهلال - {{label}}"
  title="الهلال"
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle="مقالات عن {{label}} | الهلال"
  pageDescription={`أفضل المقالات العربية المتعلقة بـ"{{label}}" — {{total}} مقالة منتقاة بعناية من مصادر متعددة.`}
  canonicalUrl="{{canonicalUrl}}"
  ogTitle="مقالات عن {{label}} | الهلال"
  ogDescription="{{total}} مقالة عربية منتقاة عن {{label}}"
  ogUrl="{{canonicalUrl}}"
  ogType="website"
>
  <script type="application/ld+json" set:html="{{{itemListLd}}}" />
  <script type="application/ld+json" set:html="{{{breadcrumbLd}}}" />

  <main id="main-content" class="tag-page">
    <FeedChrome />
    <nav class="breadcrumb" aria-label="مسار التنقل">
      <a href="/">الرئيسية</a>
      <span aria-hidden="true">›</span>
      <a href="/tags/">الوسوم</a>
      <span aria-hidden="true">›</span>
      <span>{"{{label}}"}</span>
    </nav>

    <header class="tag-header">
      <h1>#{"{{label}}"}</h1>
      <p class="tag-count">{"{{total}}"} مقالة</p>
    </header>
    <p class="tag-intro" set:html={intro} />

    <SisterStrip shell tiles={[]} heading="عن «{{label}}» في عالم الهلال" />

    <ExploreTiles shell tiles={[]} heading="وسوم ذات صلة" />
    <MasonryFeed client:idle cards={[]} categoryTitles={{}} />

    <div class="page-nav">
      <a href="/tags/" class="back-link">كل الوسوم →</a>
    </div>
  </main>

  <style>
    .tag-page {
      padding-bottom: var(--spacing-10);
    }

    .tag-page .breadcrumb {
      margin-top: var(--spacing-06);
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: var(--desktop-caption);
      font-family: var(--monospace);
      color: var(--content-secondary);
      margin-bottom: var(--spacing-06);
      flex-wrap: wrap;
    }
    .breadcrumb a { color: var(--content-secondary); text-decoration: none; }
    .breadcrumb a:hover { color: var(--content-primary); }

    .tag-header {
      display: flex;
      align-items: baseline;
      gap: var(--spacing-03);
      margin-bottom: var(--spacing-06);
    }
    .tag-header h1 {
      margin: 0;
      color: DarkOrange;
      font-size: clamp(1.25rem, 3vw, 1.75rem);
    }
    .tag-intro {
      max-width: 72ch;
      margin: 0 0 var(--spacing-06);
      line-height: 1.8;
      color: rgba(255,255,255,0.72);
    }
    .tag-intro :global(a) {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: rgba(255,255,255,0.3);
      text-underline-offset: 3px;
    }
    .tag-intro :global(a:hover) { color: #fff; }

    .tag-count {
      margin: 0;
      font-family: var(--monospace);
      font-size: var(--desktop-caption);
      color: var(--content-secondary);
    }

    .page-nav {
      margin-top: var(--spacing-07);
      padding-top: var(--spacing-05);
      border-top: 0.5px solid var(--border-muted);
    }
    .back-link {
      font-size: var(--desktop-body-sm);
      color: var(--content-secondary);
      text-decoration: none;
    }
    .back-link:hover { color: var(--content-primary); }
  </style>
</Layout>
