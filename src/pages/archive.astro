---
// The archive hub: every category's archive (src/lib/archive.ts), linked from the footer.
import Layout from "../layouts/Layout.astro";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import { archiveHref, categoryArchives } from "../lib/archive";

const archives = categoryArchives()
  .filter((a) => a.total > 0)
  .sort((a, b) => b.total - a.total);

const breadcrumbs = [{ name: "الرئيسية", url: "https://elhellal.com" }, { name: "الأرشيف" }];
---

<Layout
  site="الهلال - الأرشيف"
  title="الهلال"
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  pageTitle="أرشيف المقالات حسب التصنيف والشهر | الهلال"
  pageDescription="أرشيف كامل لمقالات الهلال العربية المنتقاة، مرتباً حسب التصنيف وشهر النشر."
  canonicalUrl="https://elhellal.com/archive/"
>
  <BreadcrumbSchema items={breadcrumbs} />
  <main id="main-content" class="archive-hub">
    <h1>أرشيف المقالات</h1>
    <p>كل المقالات المنتقاة، مرتبة حسب التصنيف ثم شهر النشر.</p>
    <ul role="list">
      {archives.map((a) => (
        <li>
          <a href={archiveHref(a.category)}>
            <strong>{a.title}</strong>
            <span>{a.total} مقالة · {a.months.length} شهراً</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <style>
    .archive-hub { max-width: 1000px; margin: 0 auto; padding: var(--spacing-06) var(--spacing-05) var(--spacing-10); }
    .archive-hub h1 { font-size: clamp(1.4rem, 4vw, 2rem); margin: 0 0 8px; color: var(--content-primary); }
    .archive-hub > p { color: var(--content-secondary); margin: 0 0 var(--spacing-06); }
    .archive-hub ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
    .archive-hub a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border: 0.5px solid var(--border-muted); border-radius: 10px; color: var(--content-primary); text-decoration: none; }
    .archive-hub a:hover { border-color: var(--content-secondary); }
    .archive-hub span { font-size: var(--desktop-caption); color: var(--content-secondary); }
  </style>
</Layout>
