---
// /write/ — readers write an article for الهلال, in an editor modelled on X's
// article composer: cover, big title, a sticky formatting toolbar and a rich
// (contenteditable) body. The body is serialized to markdown, so the push
// Worker (POST /api/push/submit → D1 submissions) and the admin Submissions
// queue (→ src/content/community/<slug>.md) are unchanged. The byline,
// summary and category are asked for in the Publish dialog. Turnstile shows
// only when PUBLIC_TURNSTILE_SITEKEY is set at build (the Worker checks it
// only when its TURNSTILE_SECRET is set).
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { getFeeds } from "../lib/feed-data";
import { articlesCountAr } from "../lib/native";

const categories = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), "src/data/catalog/categories.json"), "utf8")
) as Array<{ category: string; title: string }>;
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "";
const nativeCount = (await getFeeds()).get("native")!.newest.length;

const icon = (d: string) =>
    `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const tools = [
    { cmd: "bold", label: "غامق (Ctrl+B)", svg: icon('<path d="M6 4h8a4 4 0 0 1 0 8H6zM6 12h9a4 4 0 0 1 0 8H6z"/>') },
    { cmd: "italic", label: "مائل (Ctrl+I)", svg: icon('<path d="M19 4h-9M14 20H5M15 4 9 20"/>') },
    { cmd: "strikeThrough", label: "يتوسطه خط", svg: icon('<path d="M16 4H9a3 3 0 0 0-2.83 4M14 12a4 4 0 0 1 0 8H6M4 12h16"/>') },
    { sep: true },
    { cmd: "insertUnorderedList", label: "قائمة نقطية", svg: icon('<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>') },
    { cmd: "insertOrderedList", label: "قائمة مرقّمة", svg: icon('<path d="M10 6h11M10 12h11M10 18h11M4 6h1v4M4 10h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/>') },
    { cmd: "quote", label: "اقتباس", svg: icon('<path d="M3 21c3 0 7-1 7-8V5c0-1.25-.76-2-2-2H4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 0-1 1v3c0 1 0 1 1 1zM15 21c3 0 7-1 7-8V5c0-1.25-.76-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>') },
    { sep: true },
    { cmd: "link", label: "رابط", svg: icon('<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>') },
    { cmd: "image", label: "صورة", svg: icon('<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/>') },
    { cmd: "divider", label: "فاصل", svg: icon('<path d="M4 12h16"/><path d="M8 6h8M8 18h8" opacity=".35"/>') },
] as const;
---

<Layout
    site="الهلال"
    title="اكتب مقالاً"
    tagline="انشر مقالك على الهلال"
    pageTitle="اكتب مقالاً على الهلال"
    pageDescription="اكتب مقالك بالعربية وأرسله إلى الهلال. نراجع كل مقال وننشر الجيد منها."
    canonicalUrl="https://elhellal.com/write/"
>
    <main id="main-content" class="ed-page">
        <h1 class="ed-sr">اكتب مقالاً</h1>

        <div class="ed-bar">
            <div class="ed-bar-state">
                <span class="ed-chip">مسودة</span>
                <span class="ed-saved" data-saved></span>
            </div>
            <div class="ed-bar-actions">
                <span class="ed-words" data-words></span>
                <button type="button" class="ed-publish" data-open-publish>نشر</button>
            </div>
        </div>

        <div class="ed-cover" data-cover>
            <button type="button" class="ed-cover-add" data-cover-add>
                <span set:html={icon('<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/>')} />
                <span>أضف صورة غلاف</span>
                <small>نسبة 5:2 تبدو أفضل</small>
            </button>
            <img class="ed-cover-img" data-cover-img alt="" hidden />
            <div class="ed-cover-tools" data-cover-tools hidden>
                <button type="button" data-cover-edit>تغيير</button>
                <button type="button" data-cover-remove>إزالة</button>
            </div>
            <div class="ed-cover-form" data-cover-form hidden>
                <input type="url" dir="ltr" placeholder="https://… رابط صورة تملك حق نشرها" maxlength="500" data-cover-input />
                <button type="button" class="ed-pop-ok" data-cover-ok>حفظ</button>
                <button type="button" data-cover-cancel>إلغاء</button>
            </div>
        </div>

        <textarea class="ed-title" data-title rows="1" maxlength="150" placeholder="أضف عنواناً" aria-label="عنوان المقال"></textarea>

        <div class="ed-toolbar" role="toolbar" aria-label="تنسيق" data-toolbar>
            <div class="ed-tools">
            <select class="ed-block" data-block aria-label="نوع النص">
                <option value="p">نص</option>
                <option value="h2">عنوان</option>
                <option value="h3">عنوان فرعي</option>
            </select>
            {tools.map((t) =>
                "sep" in t ? <span class="ed-sep" /> : (
                    <button type="button" class="ed-tool" data-cmd={t.cmd} title={t.label} aria-label={t.label} aria-pressed="false" set:html={t.svg} />
                )
            )}
            </div>
            <div class="ed-pop" data-pop hidden>
                <input type="url" dir="ltr" placeholder="https://…" data-pop-input />
                <button type="button" class="ed-pop-ok" data-pop-ok>إضافة</button>
                <button type="button" data-pop-cancel>إلغاء</button>
            </div>
        </div>

        <div
            class="ed-body article-prose"
            data-body
            contenteditable="true"
            dir="rtl"
            role="textbox"
            aria-multiline="true"
            aria-label="نص المقال"
            data-placeholder="ابدأ الكتابة… اكتب ## لعنوان، و- لقائمة، و> لاقتباس"
        ></div>

        <p class="ed-foot">
            نراجع كل مقال يدوياً قبل نشره. مسودتك محفوظة في متصفحك.
            {nativeCount > 0 && <a href="/written/">{articlesCountAr(nativeCount)} كُتبت على الهلال حتى الآن</a>}
        </p>

        <dialog class="ed-dialog" data-dialog aria-labelledby="ed-dialog-title">
            <form class="ed-form" data-form novalidate>
                <div class="ed-dialog-head">
                    <h2 id="ed-dialog-title">نشر المقال</h2>
                    <button type="button" class="ed-close" data-close aria-label="إغلاق">✕</button>
                </div>
                <div class="ed-dialog-body" data-dialog-body>
                    <label>
                        <span>اسمك كما سيظهر</span>
                        <input name="author" required minlength="2" maxlength="60" autocomplete="name" />
                    </label>
                    <label>
                        <span>وصف قصير يظهر في البطاقات <small data-desc-count></small></span>
                        <textarea name="description" rows="3" required minlength="20" maxlength="300"></textarea>
                    </label>
                    <label>
                        <span>التصنيف</span>
                        <select name="category" required>
                            <option value="">اختر تصنيفاً</option>
                            {categories.map((c) => <option value={c.category}>{c.title}</option>)}
                        </select>
                    </label>
                    <details class="ed-more">
                        <summary>اختياري</summary>
                        <label>
                            <span>بريدك (للتواصل معك فقط، لا يُنشر)</span>
                            <input name="email" type="email" dir="ltr" maxlength="200" autocomplete="email" />
                        </label>
                        <label>
                            <span>رابطك (موقعك أو حسابك)</span>
                            <input name="authorUrl" type="url" dir="ltr" placeholder="https://…" maxlength="500" />
                        </label>
                    </details>

                    <input class="ed-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

                    <label class="ed-check">
                        <input type="checkbox" name="rights" required />
                        <span>أؤكد أن المقال من كتابتي، وأوافق على نشره على الهلال وفق <a href="/terms/">الشروط</a>.</span>
                    </label>

                    {sitekey && <div class="cf-turnstile" data-sitekey={sitekey} data-language="ar"></div>}

                    <button type="submit" class="ed-send">أرسل المقال للمراجعة</button>
                    <p class="ed-status" data-status role="status"></p>
                </div>
                <div class="ed-done" data-done hidden>
                    <p class="ed-done-title">شكراً! وصل مقالك.</p>
                    <p>سنراجعه قبل النشر، وقد نتواصل معك إن تركت بريدك.</p>
                    <button type="button" class="ed-send" data-close>اكتب مقالاً آخر</button>
                </div>
            </form>
        </dialog>
    </main>
    {sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Layout>

<script>
    import { BLOCK, escapeHtml, htmlToMd, mdToHtml } from "../lib/editor-md";

    const DRAFT_KEY = "elhellal:write-draft";
    const META = ["author", "description", "category", "email", "authorUrl"] as const;
    const MIN_BODY = 1500;

    // ---------- page ----------

    function setup() {
        if (location.pathname !== "/write/") return;
        const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
        const editor = $("[data-body]");
        const title = $<HTMLTextAreaElement>("[data-title]");
        const toolbar = $("[data-toolbar]");
        const blockSel = $<HTMLSelectElement>("[data-block]");
        const pop = $("[data-pop]");
        const popInput = $<HTMLInputElement>("[data-pop-input]");
        const words = $("[data-words]");
        const saved = $("[data-saved]");
        const coverImg = $<HTMLImageElement>("[data-cover-img]");
        const coverAdd = $("[data-cover-add]");
        const coverTools = $("[data-cover-tools]");
        const coverForm = $("[data-cover-form]");
        const coverInput = $<HTMLInputElement>("[data-cover-input]");
        const dialog = $<HTMLDialogElement>("[data-dialog]");
        const form = $<HTMLFormElement>("[data-form]");
        const status = $("[data-status]");
        const descCount = $("[data-desc-count]");
        const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
        const openedAt = Date.now();
        let cover = "";

        document.execCommand("defaultParagraphSeparator", false, "p");
        document.execCommand("styleWithCSS", false, "false");

        // Title grows with its text, like X's.
        const fitTitle = () => {
            title.style.height = "auto";
            title.style.height = `${title.scrollHeight}px`;
        };

        const setCover = (url: string) => {
            cover = url;
            coverImg.hidden = !url;
            coverTools.hidden = !url;
            coverAdd.hidden = !!url;
            coverForm.hidden = true;
            if (url) coverImg.src = url;
            else coverImg.removeAttribute("src");
        };

        const ensureParagraph = () => {
            if (!editor.firstElementChild) editor.innerHTML = "<p><br></p>";
            editor.toggleAttribute("data-empty", !editor.textContent!.trim() && !editor.querySelector("img,hr,li"));
        };

        const bodyMd = () => htmlToMd(editor);

        const updateCount = () => {
            const text = (editor.textContent ?? "").trim();
            const n = bodyMd().length;
            const w = text ? text.split(/\s+/).length : 0;
            words.textContent = `${w} كلمة`;
            words.title = n < MIN_BODY ? `يحتاج المقال ${MIN_BODY - n} حرفاً أخرى على الأقل` : "";
            words.classList.toggle("is-short", n < MIN_BODY);
        };

        // ---- draft ----
        try {
            const draft = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? "{}");
            if (typeof draft.title === "string") title.value = draft.title;
            if (typeof draft.body === "string") editor.innerHTML = mdToHtml(draft.body);
            if (typeof draft.cover === "string" && /^https:\/\//.test(draft.cover)) setCover(draft.cover);
            for (const name of META) if (typeof draft[name] === "string") field(name).value = draft[name];
        } catch {}
        ensureParagraph();
        fitTitle();
        updateCount();

        let saveTimer: number | undefined;
        const save = () => {
            clearTimeout(saveTimer);
            saved.textContent = "";
            saveTimer = window.setTimeout(() => {
                try {
                    localStorage.setItem(
                        DRAFT_KEY,
                        JSON.stringify({
                            title: title.value,
                            body: bodyMd(),
                            cover,
                            ...Object.fromEntries(META.map((n) => [n, field(n).value])),
                        })
                    );
                    saved.textContent = "محفوظة";
                } catch {}
            }, 600);
        };

        title.addEventListener("input", () => {
            fitTitle();
            save();
        });
        title.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                editor.focus();
            }
        });
        form.addEventListener("input", save);

        // ---- toolbar state ----
        const blockAt = (): HTMLElement | null => {
            const sel = getSelection();
            if (!sel?.rangeCount || !editor.contains(sel.anchorNode)) return null;
            let n: Node | null = sel.anchorNode;
            while (n && n.parentNode !== editor) n = n.parentNode;
            return n instanceof HTMLElement ? n : null;
        };
        const inQuote = () => {
            const sel = getSelection();
            const el = sel?.anchorNode instanceof Element ? sel.anchorNode : sel?.anchorNode?.parentElement;
            return !!el?.closest("blockquote") && editor.contains(el!);
        };
        const refresh = () => {
            const block = blockAt();
            toolbar.classList.toggle("is-idle", !block);
            if (!block) return;
            blockSel.value = block.tagName === "H2" ? "h2" : block.tagName === "H3" ? "h3" : "p";
            toolbar.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((b) => {
                const cmd = b.dataset.cmd!;
                let on = false;
                if (cmd === "quote") on = inQuote();
                else if (cmd === "link") on = !!getSelection()?.anchorNode?.parentElement?.closest("a");
                else if (!["image", "divider"].includes(cmd)) on = document.queryCommandState(cmd);
                b.setAttribute("aria-pressed", String(on));
            });
        };
        document.addEventListener("selectionchange", refresh);

        // Chrome nests lists (and the paragraph after them) inside the <p> they
        // were made from; unwrap so every block sits directly in the editor.
        const normalize = () => {
            const sel = getSelection();
            const at = sel?.rangeCount ? [sel.anchorNode, sel.anchorOffset] as const : null;
            let p: Element | null;
            while ((p = editor.querySelector(":scope > p:has(> ul, > ol, > p, > blockquote, > h2, > h3, > hr, > figure)"))) {
                const kids = [...p.childNodes];
                const out: Node[] = [];
                let run: HTMLParagraphElement | null = null;
                for (const k of kids) {
                    if (k instanceof HTMLElement && BLOCK.test(k.tagName)) {
                        run = null;
                        out.push(k);
                    } else if (k.nodeType !== Node.TEXT_NODE || k.textContent!.trim()) {
                        if (!run) out.push((run = document.createElement("p")));
                        run.append(k);
                    }
                }
                p.replaceWith(...out);
            }
            if (at?.[0] && editor.contains(at[0])) {
                try {
                    sel!.collapse(at[0], at[1]);
                } catch {}
            }
        };

        const changed = () => {
            normalize();
            ensureParagraph();
            updateCount();
            save();
            refresh();
        };

        // ---- commands ----
        let savedRange: Range | null = null;
        const keepRange = () => {
            const sel = getSelection();
            if (sel?.rangeCount && editor.contains(sel.anchorNode)) savedRange = sel.getRangeAt(0).cloneRange();
        };
        const restoreRange = () => {
            editor.focus();
            if (savedRange) {
                const sel = getSelection()!;
                sel.removeAllRanges();
                sel.addRange(savedRange);
            }
        };
        editor.addEventListener("keyup", keepRange);
        editor.addEventListener("mouseup", keepRange);
        editor.addEventListener("blur", keepRange);

        const exec = (cmd: string, value?: string) => {
            restoreRange();
            document.execCommand(cmd, false, value);
            keepRange();
            changed();
        };

        let popMode: "link" | "image" = "link";
        const openPop = (mode: "link" | "image") => {
            popMode = mode;
            const existing = getSelection()?.anchorNode?.parentElement?.closest("a");
            popInput.value = mode === "link" && existing ? existing.getAttribute("href") ?? "" : "";
            popInput.placeholder = mode === "link" ? "https://… الرابط" : "https://… رابط الصورة";
            pop.hidden = false;
            popInput.focus();
        };
        const closePop = () => {
            pop.hidden = true;
            restoreRange();
        };
        const confirmPop = () => {
            const url = popInput.value.trim();
            const ok = popMode === "image" ? /^https:\/\/\S+$/.test(url) : /^https?:\/\/\S+$/.test(url);
            if (!ok) {
                popInput.setCustomValidity(popMode === "image" ? "رابط يبدأ بـ https://" : "رابط يبدأ بـ https://");
                popInput.reportValidity();
                popInput.setCustomValidity("");
                return;
            }
            pop.hidden = true;
            if (popMode === "image") {
                exec("insertHTML", `<figure contenteditable="false"><img src="${escapeHtml(url)}" alt=""></figure><p><br></p>`);
                return;
            }
            restoreRange();
            if (getSelection()!.isCollapsed) exec("insertHTML", `<a href="${escapeHtml(url)}">${escapeHtml(url)}</a>&nbsp;`);
            else exec("createLink", url);
        };
        $("[data-pop-ok]").onclick = confirmPop;
        $("[data-pop-cancel]").onclick = closePop;
        popInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                confirmPop();
            } else if (e.key === "Escape") closePop();
        });

        // Buttons keep the editor's selection: no focus steal on mousedown.
        toolbar.addEventListener("mousedown", (e) => {
            if ((e.target as Element).closest("button.ed-tool")) e.preventDefault();
        });
        toolbar.querySelectorAll<HTMLButtonElement>("[data-cmd]").forEach((b) => {
            b.onclick = () => {
                const cmd = b.dataset.cmd!;
                if (cmd === "quote") exec("formatBlock", inQuote() ? "p" : "blockquote");
                else if (cmd === "link") {
                    keepRange();
                    openPop("link");
                } else if (cmd === "image") {
                    keepRange();
                    openPop("image");
                } else if (cmd === "divider") exec("insertHTML", "<hr><p><br></p>");
                else exec(cmd);
            };
        });
        blockSel.addEventListener("mousedown", keepRange);
        blockSel.onchange = () => exec("formatBlock", blockSel.value);

        // ---- typing ----
        editor.addEventListener("input", (e) => {
            const ie = e as InputEvent;
            // Markdown shortcuts at the start of a paragraph: "## ", "### ", "- ", "1. ", "> ", "---".
            normalize();
            const block = blockAt();
            if (block && block.tagName === "P" && ie.inputType === "insertText") {
                const text = (block.textContent ?? "").replace(/ /g, " ");
                const m = ie.data === " " ? text.match(/^(###|##|[-*]|1[.)]|>) / ) : text === "---" ? ["---", "---"] : null;
                if (m) {
                    const first = block.firstChild;
                    if (first?.nodeType === Node.TEXT_NODE) {
                        const r = document.createRange();
                        r.setStart(first, 0);
                        r.setEnd(first, Math.min(m[0].length, first.textContent!.length));
                        const sel = getSelection()!;
                        sel.removeAllRanges();
                        sel.addRange(r);
                        document.execCommand("delete");
                        const kind = m[1];
                        if (kind === "##") document.execCommand("formatBlock", false, "h2");
                        else if (kind === "###") document.execCommand("formatBlock", false, "h3");
                        else if (kind === ">") document.execCommand("formatBlock", false, "blockquote");
                        else if (kind === "---") document.execCommand("insertHTML", false, "<hr><p><br></p>");
                        else if (/^1/.test(kind)) document.execCommand("insertOrderedList");
                        else document.execCommand("insertUnorderedList");
                    }
                }
            }
            keepRange();
            changed();
        });

        editor.addEventListener("keydown", (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
                e.preventDefault();
                keepRange();
                openPop("link");
                return;
            }
            if (e.key !== "Enter" || e.shiftKey) return;
            const block = blockAt();
            if (!block) return;
            // Enter on an empty line inside a quote leaves the quote.
            if (block.tagName === "BLOCKQUOTE") {
                const sel = getSelection()!;
                const el = sel.anchorNode instanceof Element ? sel.anchorNode : sel.anchorNode?.parentElement;
                const line = el?.closest("p, div") ?? null;
                if ((line && line !== editor && !line.textContent!.trim()) || !block.textContent!.trim()) {
                    e.preventDefault();
                    document.execCommand("formatBlock", false, "p");
                    changed();
                }
            } else if (/^H[23]$/.test(block.tagName)) {
                // A heading never continues onto the next line.
                const sel = getSelection()!;
                const r = sel.getRangeAt(0);
                const tail = document.createRange();
                tail.selectNodeContents(block);
                tail.setStart(r.endContainer, r.endOffset);
                if (!tail.toString()) {
                    e.preventDefault();
                    const p = document.createElement("p");
                    p.innerHTML = "<br>";
                    block.after(p);
                    const nr = document.createRange();
                    nr.setStart(p, 0);
                    sel.removeAllRanges();
                    sel.addRange(nr);
                    changed();
                }
            }
        });

        // Paste keeps structure (headings, lists, quotes, bold, links), drops everything else.
        editor.addEventListener("paste", (e) => {
            const data = e.clipboardData;
            if (!data) return;
            e.preventDefault();
            const plain = data.getData("text/plain");
            const html = data.getData("text/html");
            let md = plain;
            if (html) {
                const doc = new DOMParser().parseFromString(html, "text/html");
                doc.querySelectorAll("script,style,meta,link,title,noscript").forEach((n) => n.remove());
                md = htmlToMd(doc.body);
            }
            if (!/\n/.test(md.trim()) && !/^(#|>|[-*] |\d+[.)] |!\[)/.test(md.trim()) && !/[*~\[]/.test(md)) {
                document.execCommand("insertText", false, plain.replace(/\s+/g, " "));
            } else {
                document.execCommand("insertHTML", false, mdToHtml(md));
            }
            changed();
        });

        // Dropped files can't be uploaded: say so instead of inlining a data: URL.
        editor.addEventListener("drop", (e) => {
            if (e.dataTransfer?.files.length) {
                e.preventDefault();
                saved.textContent = "لا يمكن رفع الصور؛ استخدم رابط صورة";
            }
        });

        // ---- cover ----
        const openCoverForm = () => {
            coverInput.value = cover;
            coverForm.hidden = false;
            coverAdd.hidden = true;
            coverInput.focus();
        };
        const saveCover = () => {
            const url = coverInput.value.trim();
            if (url && !/^https:\/\/\S+$/.test(url)) {
                coverInput.setCustomValidity("رابط يبدأ بـ https://");
                coverInput.reportValidity();
                coverInput.setCustomValidity("");
                return;
            }
            setCover(url);
            save();
        };
        coverAdd.onclick = openCoverForm;
        $("[data-cover-edit]").onclick = openCoverForm;
        $("[data-cover-remove]").onclick = () => {
            setCover("");
            save();
        };
        $("[data-cover-ok]").onclick = saveCover;
        $("[data-cover-cancel]").onclick = () => setCover(cover);
        coverInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                saveCover();
            } else if (e.key === "Escape") setCover(cover);
        });
        coverImg.onerror = () => {
            if (!cover) return;
            saved.textContent = "تعذّر تحميل صورة الغلاف";
        };

        // ---- publish ----
        const flash = (msg: string) => {
            saved.textContent = msg;
            saved.classList.add("is-alert");
            setTimeout(() => saved.classList.remove("is-alert"), 2500);
        };
        const updateDesc = () => {
            descCount.textContent = `${field("description").value.trim().length}/300`;
        };
        field("description").addEventListener("input", updateDesc);

        $("[data-open-publish]").onclick = () => {
            const n = bodyMd().length;
            if (title.value.trim().length < 5) {
                flash("أضف عنواناً للمقال أولاً");
                title.focus();
                return;
            }
            if (n < MIN_BODY) {
                flash(`المقال قصير: يحتاج ${MIN_BODY - n} حرفاً أخرى على الأقل`);
                editor.focus();
                return;
            }
            // The summary starts as the opening paragraph; the writer can rewrite it.
            const desc = field("description");
            if (!desc.value.trim()) {
                const first = [...editor.querySelectorAll("p")].map((p) => p.textContent!.trim()).find((t) => t.length >= 40) ?? "";
                desc.value = first.length > 300 ? first.slice(0, first.lastIndexOf(" ", 297)) + "…" : first;
            }
            updateDesc();
            $("[data-dialog-body]").hidden = false;
            $("[data-done]").hidden = true;
            status.textContent = "";
            dialog.showModal();
        };
        dialog.querySelectorAll<HTMLButtonElement>("[data-close]").forEach((b) => (b.onclick = () => dialog.close()));
        dialog.addEventListener("click", (e) => {
            if (e.target === dialog) dialog.close();
        });

        form.onsubmit = async (e) => {
            e.preventDefault();
            const v = (n: string) => field(n).value.trim();
            const problem =
                v("author").length < 2 ? "اكتب اسمك." :
                v("description").length < 20 ? "اكتب وصفاً قصيراً (20 حرفاً على الأقل)." :
                !v("category") ? "اختر تصنيفاً." :
                !(form.elements.namedItem("rights") as HTMLInputElement).checked ? "أكّد أن المقال من كتابتك." :
                "";
            if (problem) {
                status.textContent = problem;
                return;
            }
            const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
            button.disabled = true;
            status.textContent = "جارٍ الإرسال…";
            const turnstile = form.querySelector<HTMLInputElement>("[name='cf-turnstile-response']")?.value ?? "";
            try {
                const res = await fetch("/api/push/submit", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        ...Object.fromEntries(META.map((n) => [n, v(n)])),
                        title: title.value.trim(),
                        body: bodyMd(),
                        cover,
                        website: v("website"),
                        ms: Date.now() - openedAt,
                        turnstile,
                    }),
                });
                if (res.ok) {
                    try {
                        localStorage.removeItem(DRAFT_KEY);
                    } catch {}
                    // Keep the byline for the next article; clear the article itself.
                    const keep = { author: v("author"), email: v("email"), authorUrl: v("authorUrl") };
                    form.reset();
                    for (const [k, val] of Object.entries(keep)) field(k).value = val;
                    title.value = "";
                    editor.innerHTML = "";
                    setCover("");
                    fitTitle();
                    changed();
                    $("[data-dialog-body]").hidden = true;
                    $("[data-done]").hidden = false;
                } else if (res.status === 429) {
                    status.textContent = "أرسلت مقالات كثيرة اليوم. حاول غداً.";
                } else if (res.status === 403) {
                    status.textContent = "لم يكتمل التحقق. أعد المحاولة.";
                } else {
                    status.textContent = "تعذّر الإرسال. راجع الحقول وحاول مجدداً.";
                }
            } catch {
                status.textContent = "لا اتصال الآن. مسودتك محفوظة؛ حاول حين تتصل.";
            } finally {
                button.disabled = false;
                (window as any).turnstile?.reset?.();
            }
        };
    }

    document.addEventListener("astro:page-load", setup);
</script>

