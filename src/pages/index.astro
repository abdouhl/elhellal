---
import Layout from "../layouts/Layout.astro";

import MostRead from "../components/MostRead";
import MasonryFeed from "../components/MasonryFeed";
import ExploreTiles from "../components/ExploreTiles.astro";
import FeedChrome from "../components/FeedChrome.astro";
import "../components/MasonryFeed.css";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import ItemListSchema from "../components/schema/ItemListSchema.astro";
import { loadArticles } from "../lib/articles-data";
import { getFeeds, getCategoryTitles } from "../lib/feed-data";
import { FEED_INITIAL } from "../lib/feed";
import { categoryTiles } from "../utils/exploreTiles";

const data = loadArticles();

// Flatten all tools for the homepage ItemList
const allTools = data.articles.flatMap((category: any) => category.content);
const feed = (await getFeeds()).get("all")!;
const categoryTitles = getCategoryTitles();
---

<Layout
  site="الهلال"
  title="الهلال"
  pageTitle="الهلال — اكتشف أفضل المقالات العربية على الإنترنت"
  pageDescription="استكشف أفضل المقالات العربية في مكان واحد. الهلال يجمع محتوى عربياً عالي الجودة في مجالات التقنية والأعمال والاقتصاد والثقافة والعلوم من أبرز الكتّاب والمدونين العرب — على Substack وخارجه."
  tagline="دليل منتقى لأفضل المقالات العربية على الإنترنت"
  showSearch={true}
  ogTitle="الهلال — اكتشف أفضل المقالات العربية على الإنترنت"
  ogDescription="استكشف أفضل المقالات العربية في مكان واحد. الهلال يجمع محتوى عربياً عالي الجودة في مجالات التقنية والأعمال والاقتصاد والثقافة والعلوم من أبرز الكتّاب والمدونين العرب — على Substack وخارجه."
  ogImage="https://elhellal.com/og-image.jpg"
  ogUrl="https://elhellal.com/"
  ogType="website"
  ogSiteName="الهلال"
  twitterCard="summary_large_image"
  twitterTitle="الهلال — اكتشف أفضل المقالات العربية على الإنترنت"
  twitterDescription="استكشف أفضل المقالات العربية في مكان واحد. الهلال يجمع محتوى عربياً عالي الجودة في مجالات التقنية والأعمال والاقتصاد والثقافة والعلوم من أبرز الكتّاب والمدونين العرب — على Substack وخارجه."
  twitterImage="https://elhellal.com/og-image.jpg"
>
  <meta slot="head" name="mitgo-verification" content="d071221b-b117-487a-8de3-5ad946adda1d" />
  <OrganizationSchema />
  <ItemListSchema items={allTools} listName="Articles Directory - All Articles" />
  <main id="main-content">
    <FeedChrome />
    <ExploreTiles
      tiles={categoryTiles()}
      heading="استكشف التصنيفات"
      moreLabel="المزيد من التصنيفات"
      lessLabel="تصنيفات أقل"
    />
    <MostRead client:idle categoryTitles={categoryTitles} />
    <MasonryFeed
      client:idle
      scope="all"
      total={feed.newest.length}
      initialCards={feed.newest.slice(0, FEED_INITIAL)}
      categoryTitles={categoryTitles}
    />
  </main>
</Layout>
