---
// Imgur-style page chrome for listing pages:
//  - a top banner ad (no close button: a dismiss control on an ad invites
//    accidental clicks, which AdSense policy discourages)
//  - a floating "back to top" pill that appears once you scroll
//  - a fixed footer bar that shows on load and slides away when you scroll
import AdUnit from "./AdUnit.astro";

interface Props {
  /** Render the top banner ad (the default slot is the site's display unit). */
  adSlot?: string;
}

const { adSlot = "2951250905" } = Astro.props;
---

<div class="top-ad">
  <AdUnit slot={adSlot} minHeight={90} mobileMinHeight={250} />
</div>

<button type="button" class="to-top" aria-label="العودة إلى الأعلى">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>للأعلى</span>
</button>

<footer class="feed-footer" aria-label="روابط الموقع">
  <nav class="feed-footer-nav">
    <a href="/about/">حول الموقع</a>
    <a href="/tags/">الوسوم</a>
    <a href="/authors/">الكتّاب</a>
    <a href="https://quotes.elhellal.com/">الاقتباسات</a>
    <a href="https://books.elhellal.com/">ملخصات الكتب</a>
    <a href="https://quiz.elhellal.com/">اختبر معلوماتك</a>
    <a href="/privacy/">الخصوصية</a>
    <a href="/terms/">الشروط</a>
    <a href="/rss.xml">RSS</a>
  </nav>
  <span class="feed-footer-copy">الهلال © 2026</span>
</footer>

<script>
  const SHOW_TO_TOP_AFTER = 600; // px scrolled
  const HIDE_FOOTER_AFTER = 40;

  const onScroll = () => {
    const y = window.scrollY;
    document.querySelector(".to-top")?.classList.toggle("is-visible", y > SHOW_TO_TOP_AFTER);
    document.querySelector(".feed-footer")?.classList.toggle("is-hidden", y > HIDE_FOOTER_AFTER);
  };

  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        onScroll();
        ticking = false;
      });
    },
    { passive: true },
  );

  document.addEventListener("click", (e) => {
    if ((e.target as Element).closest?.(".to-top")) {
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  // Run now (astro:page-load may already have fired by the time this module
  // executes) and again after each view-transition navigation.
  onScroll();
  document.addEventListener("astro:page-load", onScroll);
</script>

<style>
  /* Top banner ad */
  .top-ad {
    position: relative;
    margin-top: var(--spacing-05);
    padding: 10px 12px;
    border-radius: 12px;
    background-color: #111111;
    box-shadow: 0px 0px 0px 0.5px rgba(255, 255, 255, 0.08);
  }

  .top-ad:has(ins.adsbygoogle[data-ad-status="unfilled"]) {
    display: none;
  }

  /* Back to top pill */
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 1000;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    background-color: #111111;
    color: #f0f0f0;
    font-family: var(--body-copy);
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0px 4px 16px rgba(0, 0, 0, 0.5);
    cursor: var(--c-pointer);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.15s ease;
  }

  .to-top svg {
    color: DarkOrange;
  }

  .to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .to-top:hover {
    border-color: DarkOrange;
  }

  /* Fixed footer bar — visible at the top of the page, slides away on scroll */
  .feed-footer {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: var(--spacing-05);
    padding: 12px 24px;
    background-color: var(--background-high-contrast);
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
    border-top: 1px solid var(--border-muted);
    transition: transform 0.3s ease;
  }

  .feed-footer.is-hidden {
    transform: translateY(100%);
  }

  .feed-footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .feed-footer a {
    white-space: nowrap;
    font-family: var(--monospace);
    font-size: 12px;
    color: var(--content-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .feed-footer a:hover {
    color: DarkOrange;
  }

  .feed-footer-copy {
    margin-inline-start: auto;
    font-family: var(--monospace);
    font-size: 12px;
    color: var(--content-secondary);
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .feed-footer {
      padding: 0 16px env(safe-area-inset-bottom, 0px);
    }
    /* One swipeable row of whole links — a multi-row grid would cover a big
       slice of the screen, since this bar is fixed until you scroll. */
    .feed-footer-nav {
      flex-wrap: nowrap;
      gap: 0 4px;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }
    .feed-footer-nav::-webkit-scrollbar {
      display: none;
    }
    .feed-footer a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 8px;
      font-size: 13px;
      scroll-snap-align: start;
    }
    .feed-footer-copy {
      display: none;
    }
    .to-top {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
