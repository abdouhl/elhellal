---
import type { FlatQuote } from "../types";
import { slugifyTag } from "../utils/tag-slug";

interface Props {
  quote: FlatQuote;
  showAuthor?: boolean;
  showBook?: boolean;
}

const { quote, showAuthor = true, showBook = true } = Astro.props;

const quoteUrl = `/quotes/${encodeURIComponent(quote.authorSlug)}/${encodeURIComponent(quote.id)}/`;
const authorUrl = `/quotes/${encodeURIComponent(quote.authorSlug)}/`;
const bookUrl = quote.bookSlug ? `/quotes/book/${encodeURIComponent(quote.bookSlug)}/` : undefined;
const hasMeta = showAuthor || (showBook && quote.book) || (quote.tags && quote.tags.length > 0) || typeof quote.likes === "number";
---

<li class="quote-row">
  <blockquote class="quote-row-text">
    <a href={quoteUrl}>{quote.text}</a>
  </blockquote>

  {hasMeta && (
    <div class="quote-row-meta">
      {showAuthor && <a href={authorUrl} class="quote-row-author">{quote.author}</a>}

      {showBook && quote.book && (
        <>
          {showAuthor && <span class="quote-row-sep" aria-hidden="true">،</span>}
          {bookUrl ? (
            <a href={bookUrl} class="quote-row-book">{quote.book}</a>
          ) : (
            <span class="quote-row-book">{quote.book}</span>
          )}
        </>
      )}

      <span class="quote-row-spacer" aria-hidden="true"></span>

      {quote.tags && quote.tags.length > 0 && (
        <span class="quote-row-tags">
          {quote.tags.slice(0, 3).map((tag) => (
            <a href={`/quotes/tag/${encodeURIComponent(slugifyTag(tag))}/`} class="quote-row-tag">#{tag}</a>
          ))}
        </span>
      )}

      {typeof quote.likes === "number" && (
        <span class="quote-row-likes" aria-label="عدد الإعجابات">♥ {quote.likes}</span>
      )}
    </div>
  )}
</li>

<style>
  .quote-row {
    padding: var(--spacing-05) 0;
    border-bottom: 0.5px solid var(--border-muted);
  }
  .quote-row:first-child {
    padding-top: 0;
  }

  .quote-row-text {
    margin: 0 0 8px;
    padding: 0;
    border: none;
    font-size: var(--desktop-body);
    line-height: 1.9;
    color: var(--content-primary);
  }
  .quote-row-text a {
    color: inherit;
    text-decoration: none;
  }
  .quote-row-text a:hover {
    color: DarkOrange;
  }

  .quote-row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--monospace);
    font-size: var(--desktop-caption);
    color: var(--content-secondary);
  }
  .quote-row-author {
    color: DarkOrange;
    text-decoration: none;
    font-weight: 600;
  }
  .quote-row-author:hover {
    color: #ff9d33;
  }
  .quote-row-book {
    color: var(--content-secondary);
    text-decoration: none;
    font-style: italic;
  }
  .quote-row-book:hover {
    color: var(--content-primary);
  }
  .quote-row-sep {
    opacity: 0.5;
  }
  .quote-row-spacer {
    flex: 1;
  }
  .quote-row-tags {
    display: inline-flex;
    gap: 8px;
  }
  .quote-row-tag {
    color: var(--content-secondary);
    text-decoration: none;
  }
  .quote-row-tag:hover {
    color: DarkOrange;
  }
  .quote-row-likes {
    white-space: nowrap;
  }
</style>
