{
	// Fully static site: every page is prerendered, so no Worker script runs.
	// Requests are served straight from assets (no Worker CPU = no CPU-limit errors).
	// Redirects live in public/_redirects (+ the ones Astro generates); unknown
	// paths get dist/404.html with a real 404 status.
	"name": "elhellal",
	"compatibility_date": "2026-02-21",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
