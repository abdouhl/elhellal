{
	// Static-first site. Every file in dist/ is served straight from the asset
	// layer (free, no request quota, no Worker CPU). The Worker below only runs
	// for paths with NO matching file — in practice article, tag and author
	// pages, which it renders from dist/_data/ shards (see
	// workers/site/src/index.ts).
	// Redirects live in public/_redirects (+ the ones Astro generates); unknown
	// paths get dist/404.html with a real 404 status.
	"name": "elhellal",
	"main": "workers/site/src/index.ts",
	"compatibility_date": "2026-02-21",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Browser navigations to a path with no file get the 404 page straight
		// from the asset layer, without ever reaching the Worker — so these
		// URLs must go to the Worker first. It hands the few static pages there
		// (personal-blog posts and writers) back to the asset layer.
		"run_worker_first": ["/articles/*", "/tags/*", "/authors/*", "!/tags/", "!/authors/"]
	},
	// The page shells are bundled into the Worker as strings. The CSS rule
	// only lets the React components it server-renders import their styles.
	"rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.css"], "fallthrough": true }],
	"observability": {
		"enabled": true
	}
}
